# ── Vertex AI (aiplatform.googleapis.com) — Marketing credit 433.58€ ──────────
# OBLIGATORIO: estas tres variables enrutan las llamadas LLM a través de
# aiplatform.googleapis.com y consumen el crédito correcto.
# NUNCA uses GOOGLE_API_KEY — ruta al tier gratuito y no consume el crédito.
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=europe-west1

# Modelo a usar (gemini-2.5-flash recomendado por coste/capacidad)
ADK_MODEL=gemini-2.5-flash

# App
APP_NAME=invoice_router_agent
APP_ENV=dev
LOG_LEVEL=INFO

# ── Cloud Storage inbox (storage.googleapis.com) — Marketing credit ──────────
GCS_INBOX_BUCKET=your-gcp-project-inbox
LOCAL_OUTPUT_DIR=./tmp/output

# ── WhatsApp Business API ────────────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── Gmail OAuth2 ─────────────────────────────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_INBOX_ADDRESS=

# ── Supabase (próxima iteración) ─────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=agent_ops

# ── Delivery targets ──────────────────────────────────────────────────────────
GOOGLE_DRIVE_FOLDER_ID=
EXTERNAL_API_BASE_URL=
EXTERNAL_API_TOKEN=
