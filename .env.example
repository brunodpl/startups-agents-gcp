# Vertex AI routing — consuming-gcp-credits skill.
# Copy to .env for local `adk web` / `adk run`. These are NOT secrets.
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# "global" because Gemini 3 is not served from europe-west1 (still Vertex → credit)
GOOGLE_CLOUD_LOCATION=global

# Models (Gemini 3)
MODEL_FLASH=gemini-3.5-flash
MODEL_PRO=gemini-3.1-pro-preview

# App
APP_ENV=dev
LOG_LEVEL=INFO

# Firecrawl (tool fetch_url, F2) — SECRETO: pon el valor real solo en .env
FIRECRAWL_API_KEY=

# Persistencia de sesiones (Agent Engine → aiplatform → crédito Marketing).
# Resource name completo para no depender de GOOGLE_CLOUD_LOCATION (=global).
# Contiene el número de proyecto → solo en .env, nunca commitearlo.
# Crear con: vertexai.agent_engines.create(display_name="startup-diagnostics-sessions")
SESSION_SERVICE_URI=agentengine://projects/YOUR_PROJECT_NUMBER/locations/europe-west1/reasoningEngines/YOUR_ENGINE_ID
